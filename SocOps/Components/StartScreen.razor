<main class="rave-shell start-shell">
    <div class="ambient-orb ambient-orb-cyan" aria-hidden="true"></div>
    <div class="ambient-orb ambient-orb-magenta" aria-hidden="true"></div>

    <section class="start-card" aria-labelledby="start-title">
        <div class="eyebrow"><span class="live-dot"></span> Social frequency / open floor</div>
        <div class="brand-lockup">
            <span class="brand-mark" aria-hidden="true">SO</span>
            <div>
                <p class="brand-kicker">After-hours connection protocol</p>
                <h1 id="start-title">SOC <span>OPS</span></h1>
            </div>
        </div>
        <p class="start-lede">Find your people.<br /><strong>Light up the room.</strong></p>

        <div class="how-to-panel">
            <div class="panel-label">Mission briefing <span>01 — 03</span></div>
            <ol class="briefing-list">
                <li><span>01</span><p>Find someone who matches a square.</p></li>
                <li><span>02</span><p>Tap their signal to mark it live.</p></li>
                <li><span>03</span><p>Connect five across to trigger the drop.</p></li>
            </ol>
        </div>

        <div class="start-actions">
            <button @onclick="OnStart" class="rave-button primary-button">
                <span>Enter the floor</span>
                <span class="button-arrow" aria-hidden="true">↗</span>
            </button>
            <button
                type="button"
                class="pulse-toggle @(PulseMode ? "is-active" : "")"
                aria-pressed="@PulseMode"
                @onclick="TogglePulseMode">
                <span class="pulse-icon" aria-hidden="true">◉</span>
                <span>@(PulseMode ? "Pulse mode on" : "Pulse mode off")</span>
            </button>
        </div>
        <p class="start-footnote">No spectators. Just sparks.</p>
    </section>
</main>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }

    private bool PulseMode { get; set; } = true;

    private void TogglePulseMode()
    {
        PulseMode = !PulseMode;
    }
}
