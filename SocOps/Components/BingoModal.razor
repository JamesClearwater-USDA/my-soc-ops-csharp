<div class="modal-backdrop" role="presentation">
    <div class="bingo-modal" role="dialog" aria-modal="true" aria-labelledby="bingo-title">
        <div class="modal-rays" aria-hidden="true"></div>
        <div class="modal-signal" aria-hidden="true">✦</div>
        <p class="eyebrow">Transmission complete</p>
        <h2 id="bingo-title">BINGO<span>!</span></h2>
        <p class="modal-copy">Five signals aligned.<br /><strong>You found the frequency.</strong></p>
        <button @onclick="OnDismiss" class="rave-button primary-button">
            <span>Keep playing</span>
            <span class="button-arrow" aria-hidden="true">↗</span>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
