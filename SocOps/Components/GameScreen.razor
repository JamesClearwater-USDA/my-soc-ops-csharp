@using SocOps.Models

<main class="rave-shell game-shell">
    <div class="game-backdrop" aria-hidden="true"></div>
    <header class="game-header">
        <button @onclick="OnReset" class="back-button">
            <span aria-hidden="true">←</span> Exit floor
        </button>
        <div class="live-status"><span class="live-dot"></span> Floor live</div>
        <div class="round-readout">ROUND <strong>01</strong></div>
    </header>

    <section class="game-intro" aria-labelledby="game-title">
        <div>
            <p class="eyebrow">Social frequency / active</p>
            <h1 id="game-title">Make a <span>connection.</span></h1>
        </div>
        <p class="game-instruction">Tap a square when you find someone who matches its signal.</p>
    </section>

    @if (HasBingo)
    {
        <div class="bingo-banner" role="status">
            <span class="banner-spark" aria-hidden="true">✦</span>
            <span><strong>Line connected.</strong> The floor is yours.</span>
            <span class="banner-spark" aria-hidden="true">✦</span>
        </div>
    }

    <section class="board-stage" aria-label="Social bingo board">
        <div class="stage-label stage-label-top"><span>Signal grid</span><span>5 × 5</span></div>
        <BingoBoard
            Board="@Board"
            WinningSquareIds="@WinningSquareIds"
            OnSquareClick="@OnSquareClick" />
        <div class="stage-label stage-label-bottom"><span>Tap to activate</span><span>Soc Ops / 2026</span></div>
    </section>
</main>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
