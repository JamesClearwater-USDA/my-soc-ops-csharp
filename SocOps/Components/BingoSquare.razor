@using SocOps.Models

<button
    @onclick="OnClick"
    disabled="@Square.IsFreeSpace"
    class="@GetCssClasses()"
    aria-pressed="@Square.IsMarked"
    aria-label="@(Square.IsFreeSpace ? "Free space" : Square.Text)">
    <span class="square-index" aria-hidden="true">@((Square.Id + 1).ToString("00"))</span>
    <span class="square-text wrap-break-word hyphens-auto">@Square.Text</span>
    @if (Square.IsFreeSpace)
    {
        <span class="free-label">FREE</span>
    }
    else if (Square.IsMarked)
    {
        <span class="square-check" aria-hidden="true">✓</span>
    }
</button>

@code {
    [Parameter]
    public BingoSquareData Square { get; set; } = null!;

    [Parameter]
    public bool IsWinning { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string GetCssClasses()
    {
        var baseClasses = "bingo-square";
        var stateClasses = Square.IsMarked
            ? IsWinning ? "is-winning" : "is-marked"
            : "is-idle";
        var freeSpaceClasses = Square.IsFreeSpace ? "is-free" : "";

        return $"{baseClasses} {stateClasses} {freeSpaceClasses}";
    }
}
